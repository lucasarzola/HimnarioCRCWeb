rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /songs/{songId} {
      allow read: if true;
      allow write: if false;
    }

    match /Songs/{songId} {
      allow read: if true;
      allow write: if false;
    }

    match /Himnos/{songId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
